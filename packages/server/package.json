{
  "name": "@family-os/server",
  "version": "0.0.0",
  "private": true,
  "description": "Hosts the domain and implements what it depends on: the session middleware, and the local dev server. Cloudflare hosting arrives in M2.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "node src/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@effect/platform-node": "catalog:",
    "@family-os/domain": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
