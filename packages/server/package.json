{
  "name": "@family-os/server",
  "version": "0.0.0",
  "private": true,
  "description": "Hosts the domain and implements what it depends on: the session middleware, the routes, the Cloudflare Worker and the local dev server.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "node src/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/domain": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@effect/platform-node": "catalog:",
    "@family-os/domain": "workspace:*",
    "alchemy": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oauth2-mock-server": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
