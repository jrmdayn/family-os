{
  "name": "family-os",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "pnpm -r --parallel typecheck && tsc --noEmit -p tsconfig.stacks.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm -r test",
    "docs:dev": "pnpm --filter @family-os/docs dev",
    "docs:build": "pnpm --filter @family-os/docs build",
    "repos:sync": "bash scripts/sync-repos.sh",
    "dev": "pnpm --filter @family-os/server dev",
    "fos": "node packages/cli/src/fos.ts",
    "import-notion": "node packages/server/src/import-notion.ts",
    "deploy:prod": "alchemy deploy --stage prod",
    "deploy:dev": "alchemy deploy --stage dev",
    "stacks:github": "alchemy deploy --config stacks/github.ts --profile admin --stage prod",
    "stacks:github:reveal": "REVEAL_SESSION_TOKEN=true alchemy deploy --config stacks/github.ts --profile admin --stage prod"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/domain": "catalog:",
    "@alchemy.run/github": "catalog:",
    "@family-os/server": "workspace:*",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "pnpm@12.21.0"
}
